    <string name="read_none">尚未保存凭据</string>
    <string name="read_fail">解密失败：%1$s（若更换过锁屏凭据，需重新保存）</string>
    <string name="input_required">请先填写账号和密码</string>
    <string name="fill_done">已自动填入账号密码</string>
    <string name="fill_failed">自动填入失败，请点输入框手动填写</string>
    <string name="privacy_note">零网络权限 · 密码用 Android Keystore 加密（每次填充都需指纹/锁屏验证后才解密）· 用户名加密存储仅供确认框展示</string>
</resources>
