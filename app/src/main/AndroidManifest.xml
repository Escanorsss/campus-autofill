<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 部分厂商系统显示后台确认页时需要悬浮窗授权 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 可选通知授权（Android 13+ 运行时申请；当前未启用通知保活） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 电池优化白名单申请入口 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 故意不申请 INTERNET：本应用零网络 -->

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusAutofill">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 透明中转 Activity：确认卡片 + BiometricPrompt -->
        <activity
            android:name=".auth.AuthGateActivity"
            android:exported="false"
            android:theme="@style/Theme.CampusAuthGate"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <activity
            android:name=".ui.SelfTestActivity"
            android:exported="false" />

        <!-- 调试直填（ADB 验证识别+填入用，只写 TESTUSER/TESTPASS 测试串） -->
        <activity
            android:name=".ui.DebugFillActivity"
            android:exported="true"
            android:theme="@style/Theme.CampusAuthGate"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <service
            android:name=".service.FillAccessibilityService"
            android:exported="true"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
